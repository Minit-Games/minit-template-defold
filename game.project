[project]
title = Defold Minit Template
version = 1.0
dependencies#0 = https://github.com/Minit-Games/minit-defold/archive/refs/tags/v0.1.0.zip

[bootstrap]
main_collection = /main/main.collectionc
render = /render/minit.renderc

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[display]
width = 960
height = 1480
high_dpi = 1
update_frequency = 60

[graphics]
default_texture_min_filter = linear
default_texture_mag_filter = linear

[script]
shared_state = 1

[html5]
htmlfile = /web/minit.html
scale_mode = stretch
show_fullscreen_button = 0
show_made_with_defold = 0
show_console_banner = 0
heap_size = 128
