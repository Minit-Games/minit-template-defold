# ---------------------------------------------------------------- Git LFS
# Binary assets go to LFS. Not because this template's 540 KB needs it, but
# because these files are GENERATED (tools/gen-art.mjs, gen-audio.mjs,
# gen-music.mjs) and regenerating them is the normal workflow -- git stores a
# whole new blob for a compressed format every time, so history would grow by
# the full asset size on every palette tweak. It also sets the pattern before a
# fork commits a real sprite sheet.
#
# Only genuinely binary formats belong here. Defold's .atlas/.collection/.go/
# .font and Godot's .tscn/.tres/.import are TEXT and must stay out of LFS so
# they keep diffing and merging normally.
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
